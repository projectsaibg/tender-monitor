# Tender Monitor - optional technical settings.
# Copy to ".env" to override defaults. User-facing configuration (portals,
# schedules, keywords, SMTP, timezone) is managed in the UI and stored in
# SQLite - it does NOT belong here.

# --- Server ---------------------------------------------------------------
# TENDER_MONITOR_HOST=127.0.0.1
# TENDER_MONITOR_PORT=8000

# --- Storage --------------------------------------------------------------
# Relocate all data (db, downloads, reports, logs). Absolute path recommended.
# TENDER_MONITOR_DATA_DIR=D:\TenderMonitorData

# --- Default timezone (the effective value is set in Settings) ------------
# TENDER_MONITOR_TIMEZONE=Asia/Kolkata

# --- Scraper limits (per-portal values in the UI override these) ----------
# TENDER_MONITOR_MAX_PAGES=5
# TENDER_MONITOR_REQUEST_DELAY=2.0
# TENDER_MONITOR_BROWSER_TIMEOUT_MS=30000
# TENDER_MONITOR_DOWNLOAD_TIMEOUT=60
# TENDER_MONITOR_MAX_DOWNLOAD_BYTES=62914560
# TENDER_MONITOR_MAX_DOWNLOADS_PER_SCAN=200

# --- Security -------------------------------------------------------------
# Allow scanning localhost / private IPs (needed only for the bundled mock
# server or an intranet portal). Off by default (SSRF protection).
# TENDER_MONITOR_ALLOW_PRIVATE_HOSTS=0

# --- Safe-scan structure-change guard -------------------------------------
# TENDER_MONITOR_STRUCTURE_DROP_RATIO=0.4
# TENDER_MONITOR_STRUCTURE_MIN_PREV=20

# --- Open-source / author contact (shown on the About page) ---------------
# TENDER_MONITOR_CONTACT_EMAIL=enlaceet@gmail.com
# TENDER_MONITOR_CONTACT_WHATSAPP=+91-9073288770
# TENDER_MONITOR_REPO_URL=https://github.com/projectsaibg/tender-monitor

# --- Update notifications --------------------------------------------------
# URL of the JSON manifest you publish to announce new versions.
# See docs/PUBLISHING_UPDATES.md. Leave blank to disable update checks.
# TENDER_MONITOR_UPDATE_URL=https://raw.githubusercontent.com/projectsaibg/tender-monitor/main/update.json  
